# CampusLink 环境变量
# 复制此文件为 .env 并填入实际值

# JWT 签名密钥（生成: openssl rand -hex 32）
JWT_SECRET=your_jwt_secret_here

# 管理员密钥（生成: openssl rand -hex 16）
ADMIN_KEY=your_admin_key_here

# MiMo AI API 密钥
MIMO_API_KEY=your_mimo_api_key_here

# MySQL 数据库密码（可选，默认 yWw6qIvI6QCsA7IRRNnF）
CAMPUSLINK_DB_PW=your_db_password_here

# 数据加密密钥（生成: openssl rand -hex 16）
ENCRYPTION_KEY=your_encryption_key_here

# 服务端口（可选，默认 3002）
CAMPUSLINK_PORT=3002

# 服务监听地址（可选，默认 127.0.0.1）
CAMPUSLINK_HOST=127.0.0.1

# Web Push VAPID 密钥（生成: npx web-push generate-vapid-keys）
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com

# Sentry DSN（后端 — Node/Express）
SENTRY_DSN=your_sentry_dsn_here

# Sentry DSN（前端 — React，VITE_ 前缀供 Vite 构建时注入）
VITE_SENTRY_DSN=your_sentry_dsn_here
